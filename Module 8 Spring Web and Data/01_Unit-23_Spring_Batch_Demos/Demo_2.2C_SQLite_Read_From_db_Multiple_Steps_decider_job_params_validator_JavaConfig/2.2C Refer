Decider:
In some situations, more information than the ExitStatus may be required to decide which step to execute next. In this case, a JobExecutionDecider can be used to assist in the decision.

public class MyDecider implements JobExecutionDecider {
    public FlowExecutionStatus decide(JobExecution jobExecution, StepExecution stepExecution) {
        if (someCondition) {
            return "FAILED";
        }
        else {
            return "COMPLETED";
        }
    }
}
In the job configuration, a "decision" tag will specify the decider to use as well as all of the transitions.

@Bean(name = "firstBatchJob")
	public Job firstBatchJob(@Qualifier("step1")Step step1,
			@Qualifier("step2")Step step2, 
			@Qualifier("step3_error")Step step3,
			@Qualifier("step4")Step step4,
			@Qualifier("msd_decider")MSDDecider msdDecider,
			MSDJobParameterValidator jobParameterValidator) {
		return jobBuilderFactory.get("firstBatchJob")
					.validator(jobParameterValidator)
					.start(step1)
					.next(step2)
					.next(msdDecider)
					.from(msdDecider).on("FAILED").to(step3)
					.from(msdDecider).on("COMPLETED").to(step4)
					.end()
					.build();
	}


	@Bean(name="msd_decider")
	public MSDDecider msdDecider() {
		return new MSDDecider();
	}
	
