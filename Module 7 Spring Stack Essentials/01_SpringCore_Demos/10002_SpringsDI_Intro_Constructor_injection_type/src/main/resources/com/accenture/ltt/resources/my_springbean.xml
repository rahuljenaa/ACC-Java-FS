<?xml version="1.0" encoding="UTF-8"?>
<beans xmlns="http://www.springframework.org/schema/beans"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://www.springframework.org/schema/beans
        http://www.springframework.org/schema/beans/spring-beans.xsd">


	<bean id="primaryContact" class="com.accenture.ltt.bean.Contact">
		<constructor-arg value="1" />
		<constructor-arg value="tom@gmail.com" type="java.lang.String" />
	</bean>

	<bean id="secondaryContact" class="com.accenture.ltt.bean.Contact">
		<constructor-arg value="tommy@gmail.com" type="java.lang.String" />
		<constructor-arg value="2" />
	</bean>

</beans>