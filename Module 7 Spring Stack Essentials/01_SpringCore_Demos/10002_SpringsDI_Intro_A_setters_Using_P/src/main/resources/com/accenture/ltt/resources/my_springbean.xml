<?xml version="1.0" encoding="UTF-8"?>
<beans xmlns="http://www.springframework.org/schema/beans"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://www.springframework.org/schema/beans
        http://www.springframework.org/schema/beans/spring-beans.xsd"
	xmlns:p="http://www.springframework.org/schema/p">

    <!-- check out salary1 is name of the setter not variable -->
	<bean id="empObject1" class="com.accenture.ltt.bean.Employee"
		p:employeeId="1001" 
		p:salary="50000" 
		p:address-ref="addressObject1">
	</bean>
	
	<bean id="addressObject1" class="com.accenture.ltt.bean.Address"
		p:addressLine1="HSR Layout, Sector1"
		p:addressLine2="Bangalore, Karnatka">
	</bean>

	<bean id="empObject2" class="com.accenture.ltt.bean.Employee"
		p:employeeId="1001" 
		p:salary="50000" 
		p:address-ref="addressObject2">
	</bean>
	<bean id="addressObject2" class="com.accenture.ltt.bean.Address"
		p:addressLine1= "Pune, Magarpatta"
		p:addressLine2="addressLine2"><!-- Setter Injection -->
	</bean>

</beans>